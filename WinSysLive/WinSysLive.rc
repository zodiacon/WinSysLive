/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_COLUMNS DIALOGEX 0, 0, 230, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Columns"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose the columns to show and their order:",IDC_STATIC,7,7,216,9
    EDITTEXT        IDC_FILTER,7,19,160,13,ES_AUTOHSCROLL
    CONTROL         "",IDC_COLUMNS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,7,37,160,157
    PUSHBUTTON      "Move &Up",IDC_MOVEUP,173,37,50,14
    PUSHBUTTON      "Move &Down",IDC_MOVEDOWN,173,55,50,14
    PUSHBUTTON      "De&faults",IDC_DEFAULTS,173,79,50,14
    DEFPUSHBUTTON   "OK",IDOK,119,199,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,173,199,50,14
END

IDD_ABOUTBOX DIALOG  0, 0, 187, 102
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,130,81,50,14
    CTEXT           "WinSysLive Application v1.0\n\n(c) Copyright 2026",IDC_STATIC,25,57,78,
                    32
    ICON            IDR_MAINFRAME,IDC_STATIC,55,26,18,20
    GROUPBOX        "",IDC_STATIC,7,7,115,88
END




