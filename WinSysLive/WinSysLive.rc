/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Run as &Administrator",        ID_FILE_RUNASADMIN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Processes\tCtrl+1",          ID_VIEW_PROCESSES
        MENUITEM "&Services\tCtrl+2",           ID_VIEW_SERVICES
        MENUITEM "P&erformance\tCtrl+3",        ID_VIEW_PERFORMANCE
        MENUITEM SEPARATOR
        MENUITEM "Process &Tree\tCtrl+T",        ID_VIEW_PROCESSTREE
        MENUITEM "Select &Columns...",          ID_VIEW_SELECTCOLUMNS
        MENUITEM SEPARATOR
        MENUITEM "&Refresh\tF5",                 ID_VIEW_REFRESH
        MENUITEM "&Pause Updates\tSpace",        ID_VIEW_PAUSE
        POPUP "&Update Interval"
        BEGIN
            MENUITEM "0.5 Seconds",                  ID_UPDATEINTERVAL_500
            MENUITEM "1 Second",                     ID_UPDATEINTERVAL_1000
            MENUITEM "2 Seconds",                    ID_UPDATEINTERVAL_2000
            MENUITEM "5 Seconds",                    ID_UPDATEINTERVAL_5000
        END
        MENUITEM SEPARATOR
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Dark Mode",                  ID_OPTIONS_DARKMODE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About WinSysLive",              ID_APP_ABOUT
    END
END

IDR_CONTEXT MENU
BEGIN
    POPUP "Process"
    BEGIN
        MENUITEM "&Kill Process\tDel",           ID_PROCESS_KILL
        MENUITEM "&Suspend",                     ID_PROCESS_SUSPEND
        MENUITEM "&Resume",                      ID_PROCESS_RESUME
        MENUITEM SEPARATOR
        POPUP "&Priority"
        BEGIN
            MENUITEM "&Realtime",                    ID_PRIORITY_REALTIME
            MENUITEM "&High",                        ID_PRIORITY_HIGH
            MENUITEM "&Above Normal",                ID_PRIORITY_ABOVENORMAL
            MENUITEM "&Normal",                      ID_PRIORITY_NORMAL
            MENUITEM "&Below Normal",                ID_PRIORITY_BELOWNORMAL
            MENUITEM "&Idle",                        ID_PRIORITY_IDLE
        END
        MENUITEM SEPARATOR
        MENUITEM "Open File &Location",          ID_PROCESS_GOTOFILELOCATION
        MENUITEM SEPARATOR
        MENUITEM "&Copy\tCtrl+C",                ID_EDIT_COPY
    END
    POPUP "Service"
    BEGIN
        MENUITEM "&Start",                       ID_SERVICE_START
        MENUITEM "S&top",                        ID_SERVICE_STOP
        MENUITEM "&Pause",                       ID_SERVICE_PAUSE
        MENUITEM "&Continue",                    ID_SERVICE_CONTINUE
        MENUITEM "&Restart",                     ID_SERVICE_RESTART
        MENUITEM SEPARATOR
        MENUITEM "&Go to Process",               ID_SERVICE_GOTOPROCESS
        MENUITEM SEPARATOR
        MENUITEM "&Copy\tCtrl+C",                ID_EDIT_COPY
    END
    POPUP "Column"
    BEGIN
        MENUITEM "&Hide Column",                 ID_COLUMN_HIDE
        MENUITEM SEPARATOR
        MENUITEM "Select &Columns...",           ID_VIEW_SELECTCOLUMNS
    END
END

