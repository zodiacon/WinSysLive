    LTEXT           "Parent:",IDC_STATIC,130,89,26,9
    EDITTEXT        IDC_PROC_PARENT,158,87,165,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "User:",IDC_STATIC,7,106,50,9
    EDITTEXT        IDC_PROC_USER,60,104,185,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Session:",IDC_STATIC,253,106,30,9
    EDITTEXT        IDC_PROC_SESSION,288,104,35,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Started:",IDC_STATIC,7,123,50,9
    EDITTEXT        IDC_PROC_STARTED,60,121,124,13,ES_AUTOHSCROLL | ES_READONLY
