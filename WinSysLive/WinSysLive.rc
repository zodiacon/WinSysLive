IDD_HIGHLIGHTING DIALOGEX 0, 0, 260, 118
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Highlighting"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "New items are highlighted in green, and exited, closed, unloaded or removed ones in red, which then stay in the lists for that long. Zero turns it off: exited items then go at once.",IDC_STATIC,7,7,246,26
    LTEXT           "Highlight &new items for:",IDC_STATIC,7,42,100,9
    EDITTEXT        IDC_HL_NEW,110,40,32,13,ES_NUMBER
    CONTROL         "",IDC_HL_NEWSPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,142,40,10,13
    LTEXT           "seconds",IDC_STATIC,148,42,40,9
    LTEXT           "Highlight &exited items for:",IDC_STATIC,7,60,100,9
    EDITTEXT        IDC_HL_EXITED,110,58,32,13,ES_NUMBER
    CONTROL         "",IDC_HL_EXITEDSPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,142,58,10,13
    LTEXT           "seconds",IDC_STATIC,148,60,40,9
    LTEXT           "",IDC_HL_UPDATES,7,79,246,9,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,149,97,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,203,97,50,14
END

IDD_VIRUSTOTAL DIALOGEX 0, 0, 300, 136
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VirusTotal"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Files are looked up on VirusTotal by their SHA-256 hash: only the hash is sent. A file is uploaded only when you choose Submit File in its VirusTotal menu.",IDC_STATIC,7,7,286,26
    LTEXT           "&API key:",IDC_STATIC,7,41,60,9
    EDITTEXT        IDC_VT_KEY,70,39,180,13,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "&Show",IDC_VT_SHOWKEY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,256,40,40,10
    CONTROL         "<a href=""https://www.virustotal.com/gui/my-apikey"">Get your API key</a> (a free VirusTotal account)",IDC_VT_LINK,
