    LTEXT           "",IDC_PROC_CET,194,166,122,9,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "Signature:",IDC_STATIC,15,183,36,9
    LTEXT           "",IDC_PROC_SIGNATURE,53,183,209,9,SS_NOPREFIX | SS_ENDELLIPSIS
