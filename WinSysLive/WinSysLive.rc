IDD_PROC_GENERAL DIALOGEX 0, 0, 330, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CAPTION
CAPTION "General"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            "",IDC_PROC_ICON,7,7,20,20
    LTEXT           "",IDC_PROC_NAME,36,8,287,10,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "",IDC_PROC_DESCRIPTION,36,19,287,10,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "Image path:",IDC_STATIC,7,38,50,9
    EDITTEXT        IDC_PROC_PATH,60,36,263,13,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Command line:",IDC_STATIC,7,55,50,9
    EDITTEXT        IDC_PROC_COMMANDLINE,60,53,263,28,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT           "Process ID:",IDC_STATIC,7,89,50,9
