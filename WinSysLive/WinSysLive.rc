END

STRINGTABLE
BEGIN
    ID_FILE_RUNASADMIN      "Restart with administrator rights\nRun as Administrator"
    ID_FILE_RUN             "Start a program, folder, document or Internet resource\nRun"
    ID_FILE_RUNAS           "Start a program as another user\nRun As"
    ID_VIEW_PAUSE           "Stop or resume periodic updates\nPause/Resume Updates (Space)"
END

STRINGTABLE
BEGIN
    ID_PANE_PROCESSES       "Processes: 00000"
    ID_PANE_CPU             "CPU: 100.0%  "
    ID_PANE_ELEVATION       "Standard User  "
    ID_PROCESS_KILL         "Terminate the selected process\nKill Process"
    ID_PROCESS_SUSPEND      "Suspend all the threads of the selected process\nSuspend"
    ID_PROCESS_RESUME       "Resume the threads of the selected process\nResume"
    ID_PROCESS_GOTOFILELOCATION 
                            "Open the folder of the selected process's executable in Explorer\nOpen File Location"
    ID_VIEW_PROCESSTREE     "Show processes as a tree or a flat list\nProcess Tree (Ctrl+T)"
END

STRINGTABLE
BEGIN
    ID_KILL                 "Terminate the selected process or thread, or close the selected handle: the list with the focus decides\nKill (Del)"
    ID_PROCESS_MINIDUMP     "Write a minidump of the selected process (threads, modules, handles)\nMinidump"
    ID_PROCESS_FULLDUMP     "Write a dump of the selected process with all its memory\nFull Dump"
    ID_FIND_HANDLE          "Find the processes with a handle or a DLL whose name contains a text\nFind Handle or DLL"
END

STRINGTABLE
BEGIN
    ID_VIEW_SELECTCOLUMNS   "Choose the columns of the list and their order\nSelect Columns"
    ID_COLUMN_HIDE          "Hide the column that was right-clicked\nHide Column"
    ID_VIEW_LOWERPANE       "Show or hide the handles, modules and threads of the selected process\nLower Pane (Ctrl+L)"
    ID_PANE_THREADS         "Threads: 000,000"
    ID_PROCESS_KILLALL      "Terminate all the processes with the selected process's image name\nKill All with the Same Name"
    ID_VIEW_PROPERTIES      "Show the properties of the selected process\nProperties (Alt+Enter)"
END

STRINGTABLE
BEGIN
    ID_PROCESS_AFFINITY     "Choose the processors the selected process may run on\nSet Affinity"
    ID_PROCESS_EFFICIENCY   "Run the selected process with low priority and power efficiency (EcoQoS), as Task Manager does\nEfficiency Mode"
    ID_VIEW_NETWORK         "Show the TCP connections and UDP endpoints of all processes\nNetwork"
    ID_VIEW_KERNELMODULES   "Show the kernel's loaded modules: the kernel, the HAL and the drivers\nKernel Modules"
    ID_VIEW_DRIVERS         "Show the driver services: kernel and file system drivers\nDrivers"
    ID_KMODULE_PROPERTIES    "Show the properties of the selected driver's file\nProperties"
    ID_KMODULE_GOTOFILELOCATION 
                            "Open the folder of the selected driver's file\nOpen File Location"
    ID_OPTIONS_TRAYICON     "Show a CPU usage graph in the notification area\nTray Icon"
    ID_OPTIONS_MINIMIZETOTRAY 
                            "Hide the window from the taskbar when it's minimized (the tray icon brings it back)\nMinimize to Tray"
    ID_OPTIONS_ALWAYSONTOP  "Keep the window above the other windows\nAlways on Top"
END

STRINGTABLE
BEGIN
    ID_OPTIONS_REPLACETASKMANAGER 
