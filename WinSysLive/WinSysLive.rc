STRINGTABLE
BEGIN
    ID_FILE_NEW             "Create a new document\nNew"
    ID_FILE_OPEN            "Open an existing document\nOpen"
    ID_FILE_CLOSE           "Close the active document\nClose"
    ID_FILE_SAVE            "Save the active document\nSave"
    ID_FILE_SAVE_AS         "Save the active document with a new name\nSave As"
    ID_FILE_PAGE_SETUP      "Change the printing options\nPage Setup"
    ID_FILE_PRINT_SETUP     "Change the printer and printing options\nPrint Setup"
    ID_FILE_PRINT           "Print the active document\nPrint"
    ID_FILE_PRINT_PREVIEW   "Display full pages\nPrint Preview"
END

STRINGTABLE
BEGIN
    ID_APP_ABOUT            "Display program information, version number and copyright\nAbout"
    ID_APP_EXIT             "Quit the application; prompts to save documents\nExit"
END

STRINGTABLE
BEGIN
    ID_NEXT_PANE            "Switch to the next window pane\nNext Pane"
    ID_PREV_PANE            "Switch back to the previous window pane\nPrevious Pane"
END

STRINGTABLE
BEGIN
    ID_WINDOW_NEW           "Open another window for the active document\nNew Window"
    ID_WINDOW_ARRANGE       "Arrange icons at the bottom of the window\nArrange Icons"
    ID_WINDOW_CASCADE       "Arrange windows so they overlap\nCascade Windows"
    ID_WINDOW_TILE_HORZ     "Arrange windows as non-overlapping tiles\nTile Windows"
    ID_WINDOW_TILE_VERT     "Arrange windows as non-overlapping tiles\nTile Windows"
    ID_WINDOW_SPLIT         "Split the active window into panes\nSplit"
END

STRINGTABLE
BEGIN
    ID_EDIT_CLEAR           "Erase the selection\nErase"
    ID_EDIT_CLEAR_ALL       "Erase everything\nErase All"
    ID_EDIT_COPY            "Copy the selection in the list with the focus\nCopy (Ctrl+C)"
    ID_EDIT_CUT             "Cut the selection and put it on the Clipboard\nCut"
    ID_EDIT_FIND            "Find the specified text\nFind"
    ID_EDIT_PASTE           "Insert Clipboard contents\nPaste"
    ID_EDIT_REPEAT          "Repeat the last action\nRepeat"
    ID_EDIT_REPLACE         "Replace specific text with different text\nReplace"
    ID_EDIT_SELECT_ALL      "Select the entire document\nSelect All"
    ID_EDIT_UNDO            "Undo the last action\nUndo"
    ID_EDIT_REDO            "Redo the previously undone action\nRedo"
END

STRINGTABLE
BEGIN
    ID_VIEW_TOOLBAR         "Show or hide the toolbar\nToggle Toolbar"
    ID_VIEW_STATUS_BAR      "Show or hide the status bar\nToggle StatusBar"
    ID_VIEW_REFRESH         "Update all views now\nRefresh (F5)"
END

STRINGTABLE
BEGIN
    ID_FILE_RUNASADMIN      "Restart with administrator rights\nRun as Administrator"
    ID_VIEW_PAUSE           "Stop or resume periodic updates\nPause/Resume Updates (Space)"
END

STRINGTABLE
BEGIN
    ID_OPTIONS_REPLACETASKMANAGER 
                            "Start WinSysLive instead of Task Manager, also for Ctrl+Shift+Esc (needs elevation)\nReplace Task Manager"
    ID_TRAY_SHOW            "Show or hide the window\nShow"
    ID_THREAD_WAITCHAIN     "Show what the selected thread waits for, and who owns that\nWait Chain"
    ID_PROCESS_WAITCHAIN    "Show what the selected process's threads wait for, deadlocks first\nAnalyze Wait Chain"
    ID_FILE_EXPORT          "Save the list with the focus (or the tab's list) as a CSV or tab-separated file\nExport List (Ctrl+S)"
    ID_EDIT_COPYALL         "Copy every row of the list with the focus (or the tab's list), tab separated\nCopy All Rows"
    ID_FILE_RUN             "Start a program, folder, document or Internet resource\nRun"
END

STRINGTABLE
BEGIN
    ID_FILE_RUNAS           "Start a program as another user\nRun As"
    ID_VIEW_KERNELMODULES   "Show the kernel's loaded modules: the kernel, the HAL and the drivers\nKernel Modules"
END

STRINGTABLE
BEGIN
    ID_FIND_WINDOW          "Drag onto a window to select the process that owns it\nFind Window's Process (drag onto a window)"
    ID_PROCESS_KILLTREE     "Terminate the selected process and all its descendants\nKill Process Tree"
    ID_PROCESS_RESTART      "Terminate the selected process and start it again with the same command line, directory and environment\nRestart"
    ID_PROCESS_EMPTYWORKINGSET 
                            "Remove all the pages from the selected process's working set\nReduce Working Set"
    ID_PROCESS_DEBUG        "Attach the registered debugger (AeDebug) to the selected process\nDebug"
    ID_VIEW_HIDEOTHERUSERS  "Hide the processes that run as other users\nHide Other Users' Processes"
END

STRINGTABLE
BEGIN
    ID_VIEW_HIDESERVICES    "Hide the processes that host running services\nHide Services"
    ID_VIEW_HIDEWINDOWS     "Hide the processes whose executable is in the Windows directory, and the system's own\nHide Windows Processes"
    ID_VIEW_HIDESIGNED      "Hide the processes whose executable has a valid signature\nHide Signed Processes"
    ID_VIEW_HIDEMENU        "Choose the processes to hide\nHide Processes"
    ID_FILE_RUNLIMITED      "Start a program without administrator rights, at medium integrity\nRun as Limited User"
    ID_PROCESS_CRITICAL     "Make the selected process critical, so Windows crashes when it exits, or no longer critical (needs elevation)\nCritical Process"
    ID_VIEW_IPC             "Show which processes talk to which over ALPC and RPC (needs elevation)\nRPC/ALPC (Ctrl+8)"
    ID_IPC_GOTOCLIENT       "Select the client process in the Processes tab\nGo to Client"
    ID_IPC_GOTOSERVER       "Select the server process in the Processes tab\nGo to Server"
    ID_VIEW_ZOMBIES         "Show the processes that exited but are kept alive by open handles, and who holds them\nZombie Processes (Ctrl+9)"
    ID_ZOMBIE_GOTOHOLDER    "Select the process holding the handle in the Processes tab\nGo to Holder"
    ID_ZOMBIE_CLOSEHANDLE   "Close the selected holder's handles to the zombie process\nClose Handles"
    ID_ZOMBIE_CLOSEALL      "Close every handle that keeps the selected zombie process alive\nClose All Handles to the Zombie"
    ID_VIEW_OBJECTTYPES     "Show the kernel's object types with their object and handle counts\nObject Types (Ctrl+0)"
    ID_TOOLS_FIRMWARE       "Show the firmware's boot entries and UEFI variables, and the TPM (needs elevation)\nFirmware and TPM"
END

STRINGTABLE
BEGIN
    ID_OPTIONS_HIGHLIGHTING "How long new and exited items stay highlighted\nHighlighting"
    ID_MEMORY_EMPTYWORKINGSETS 
